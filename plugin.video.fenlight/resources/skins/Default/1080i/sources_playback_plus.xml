<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <!-- Background -->
        <control type="group">
            <width>1920</width>
            <height>1080</height>
            <control type="image">
                <texture colordiffuse="FF000000">fenlight_common/white.png</texture>
            </control>
            <control type="image">
                <texture>$INFO[Window.Property(fanart)]</texture>
                <aspectratio>scale</aspectratio>
                <animation effect="fade" end="100" time="400">WindowOpen</animation>
            </control>
            <!-- Left scrim -->
            <control type="image">
                <left>0</left>
                <width>1600</width>
                <texture colordiffuse="E0FFFFFF">fenlight_common/scrim-left.png</texture>
            </control>
            <!-- Top and bottom shading -->
            <control type="image">
                <height>160</height>
                <texture colordiffuse="B3FFFFFF">fenlight_common/dim-top.png</texture>
            </control>
            <control type="image">
                <top>660</top>
                <height>420</height>
                <texture flipy="true">fenlight_common/dim-top.png</texture>
            </control>
        </control>
        <control type="group">
            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            <!-- Logo & Directions -->
            <control type="image">
                <left>5</left>
                <top>5</top>
                <width>60</width>
                <height>60</height>
                <aspectratio aligny="top">keep</aspectratio>
                <texture>fenlight_common/fenlight.png</texture>
            </control>
            <control type="group">
                <visible>String.IsEqual(Window.Property(window_mode),scraper)</visible>
                <control type="image">
                    <left>72</left>
                    <top>18</top>
                    <width>88</width>
                    <height>36</height>
                    <texture colordiffuse="FFCCCCCC" border="6">fenlight_common/keycap.png</texture>
                </control>
                <control type="label">
                    <left>72</left>
                    <top>18</top>
                    <width>88</width>
                    <height>36</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>[B]BACK[/B]</label>
                </control>
                <control type="label">
                    <left>172</left>
                    <top>18</top>
                    <width max="300">auto</width>
                    <height>36</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>Cancel</label>
                </control>
            </control>
            <control type="group">
                <visible>String.IsEqual(Window.Property(window_mode),resolver) + !String.IsEqual(Window.Property(enable_busy_spinner),true)</visible>
                <control type="image">
                    <left>72</left>
                    <top>18</top>
                    <width>88</width>
                    <height>36</height>
                    <texture colordiffuse="FFCCCCCC" border="6">fenlight_common/keycap.png</texture>
                </control>
                <control type="label">
                    <left>72</left>
                    <top>18</top>
                    <width>88</width>
                    <height>36</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>[B]BACK[/B]</label>
                </control>
                <control type="label">
                    <left>172</left>
                    <top>18</top>
                    <width max="110">auto</width>
                    <height>36</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>Cancel</label>
                </control>
                <control type="image">
                    <left>300</left>
                    <top>18</top>
                    <width>104</width>
                    <height>36</height>
                    <texture colordiffuse="FFCCCCCC" border="6">fenlight_common/keycap.png</texture>
                </control>
                <control type="label">
                    <left>300</left>
                    <top>18</top>
                    <width>104</width>
                    <height>36</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>[B]RIGHT[/B]</label>
                </control>
                <control type="label">
                    <left>416</left>
                    <top>18</top>
                    <width max="300">auto</width>
                    <height>36</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>Skip</label>
                </control>
            </control>
            <!-- Clearlogo or Title -->
            <control type="image">
                <left>90</left>
                <top>100</top>
                <width>640</width>
                <height>180</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <texture background="true">$INFO[Window.Property(clearlogo)]</texture>
                <visible>!String.IsEmpty(Window.Property(clearlogo))</visible>
            </control>
            <control type="label">
                <left>90</left>
                <top>190</top>
                <width>900</width>
                <height>90</height>
                <font>font60</font> <!-- FENLIGHT_60_BOLD -->
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align>
                <aligny>bottom</aligny>
                <label>[B]$INFO[Window.Property(title)][/B]</label>
                <visible>String.IsEmpty(Window.Property(clearlogo))</visible>
            </control>
            <!-- Info column -->
            <control type="grouplist">
                <left>90</left>
                <top>300</top>
                <width>900</width>
                <height>440</height>
                <orientation>vertical</orientation>
                <itemgap>8</itemgap>
                <control type="label">
                    <width>900</width>
                    <height>44</height>
                    <font>font14</font> <!-- FENLIGHT_33 -->
                    <textcolor>FFFFFFFF</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(line1)]</label>
                    <visible>!String.IsEmpty(Window.Property(line1))</visible>
                </control>
                <control type="label">
                    <width>900</width>
                    <height>38</height>
                    <font>font12</font> <!-- FENLIGHT_26 -->
                    <textcolor>FFB7B4BB</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(line2)]</label>
                    <visible>!String.IsEmpty(Window.Property(line2))</visible>
                </control>
                <control type="image">
                    <width>900</width>
                    <height>10</height>
                </control>
                <control type="textbox">
                    <width>900</width>
                    <height max="185">auto</height>
                    <font>font12</font> <!-- FENLIGHT_26 -->
                    <textcolor>FFE6E6E6</textcolor>
                    <autoscroll delay="6000" time="3000" repeat="6000">true</autoscroll>
                    <label>$INFO[Window.Property(plot_text)]</label>
                    <visible>!String.IsEmpty(Window.Property(plot_text))</visible>
                </control>
                <control type="image">
                    <width>900</width>
                    <height>10</height>
                </control>
                <control type="label">
                    <width>900</width>
                    <height>34</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFB7B4BB</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(credits_line)]</label>
                    <visible>!String.IsEmpty(Window.Property(credits_line))</visible>
                </control>
            </control>
            <!-- Live tally -->
            <control type="group" id="2210">
                <left>90</left>
                <top>828</top>
                <visible>String.IsEqual(Window.Property(window_mode),scraper)</visible>
                <!-- 4K -->
                <control type="group">
                    <left>0</left>
                    <animation effect="fade" start="100" end="45" time="200" condition="String.IsEqual(Window.Property(results_4k),0)">Conditional</animation>
                    <control type="image">
                        <width>180</width>
                        <height>124</height>
                        <texture colordiffuse="D91F2020" border="16">fenlight_common/rounded-16.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>12</top>
                        <width>150</width>
                        <height>70</height>
                        <font>font60</font> <!-- FENLIGHT_60_BOLD -->
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>[B]$INFO[Window.Property(results_4k)][/B]</label>
                    </control>
                    <control type="label">
                        <left>22</left>
                        <top>86</top>
                        <width>140</width>
                        <height>26</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>4K</label>
                    </control>
                </control>
                <!-- 1080P -->
                <control type="group">
                    <left>196</left>
                    <animation effect="fade" start="100" end="45" time="200" condition="String.IsEqual(Window.Property(results_1080p),0)">Conditional</animation>
                    <control type="image">
                        <width>180</width>
                        <height>124</height>
                        <texture colordiffuse="D91F2020" border="16">fenlight_common/rounded-16.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>12</top>
                        <width>150</width>
                        <height>70</height>
                        <font>font60</font> <!-- FENLIGHT_60_BOLD -->
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>[B]$INFO[Window.Property(results_1080p)][/B]</label>
                    </control>
                    <control type="label">
                        <left>22</left>
                        <top>86</top>
                        <width>140</width>
                        <height>26</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>1080P</label>
                    </control>
                </control>
                <!-- 720P -->
                <control type="group">
                    <left>392</left>
                    <animation effect="fade" start="100" end="45" time="200" condition="String.IsEqual(Window.Property(results_720p),0)">Conditional</animation>
                    <control type="image">
                        <width>180</width>
                        <height>124</height>
                        <texture colordiffuse="D91F2020" border="16">fenlight_common/rounded-16.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>12</top>
                        <width>150</width>
                        <height>70</height>
                        <font>font60</font> <!-- FENLIGHT_60_BOLD -->
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>[B]$INFO[Window.Property(results_720p)][/B]</label>
                    </control>
                    <control type="label">
                        <left>22</left>
                        <top>86</top>
                        <width>140</width>
                        <height>26</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>720P</label>
                    </control>
                </control>
                <!-- SD -->
                <control type="group">
                    <left>588</left>
                    <animation effect="fade" start="100" end="45" time="200" condition="String.IsEqual(Window.Property(results_sd),0)">Conditional</animation>
                    <control type="image">
                        <width>180</width>
                        <height>124</height>
                        <texture colordiffuse="D91F2020" border="16">fenlight_common/rounded-16.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>12</top>
                        <width>150</width>
                        <height>70</height>
                        <font>font60</font> <!-- FENLIGHT_60_BOLD -->
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>[B]$INFO[Window.Property(results_sd)][/B]</label>
                    </control>
                    <control type="label">
                        <left>22</left>
                        <top>86</top>
                        <width>140</width>
                        <height>26</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>SD</label>
                    </control>
                </control>
                <!-- Total -->
                <control type="group">
                    <left>784</left>
                    <control type="image">
                        <width>180</width>
                        <height>124</height>
                        <texture colordiffuse="FFCCCCCC" border="16">fenlight_common/rounded-16-outline.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>12</top>
                        <width>150</width>
                        <height>70</height>
                        <font>font60</font> <!-- FENLIGHT_60_BOLD -->
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>[B]$INFO[Window.Property(results_total)][/B]</label>
                    </control>
                    <control type="label">
                        <left>22</left>
                        <top>86</top>
                        <width>140</width>
                        <height>26</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>TOTAL</label>
                    </control>
                </control>
                <!-- Timer -->
                <control type="label">
                    <left>1340</left>
                    <top>46</top>
                    <width>400</width>
                    <height>44</height>
                    <font>font14</font> <!-- FENLIGHT_33 -->
                    <textcolor>FFFFFFFF</textcolor>
                    <align>right</align>
                    <aligny>center</aligny>
                    <label>[B]$INFO[Window.Property(time_label)][/B]</label>
                </control>
                <control type="label">
                    <left>1340</left>
                    <top>92</top>
                    <width>400</width>
                    <height>28</height>
                    <font>font10</font> <!-- FENLIGHT_21 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <align>right</align>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(time_sub)]</label>
                </control>
            </control>
            <!-- Providers -->
            <control type="panel" id="2200">
                <left>90</left>
                <top>980</top>
                <width>1740</width>
                <height>56</height>
                <orientation>vertical</orientation>
                <visible>String.IsEqual(Window.Property(window_mode),scraper)</visible>
                <itemlayout width="246" height="56">
                    <control type="image">
                        <width>234</width>
                        <height>44</height>
                        <texture colordiffuse="D91F2020" border="22">fenlight_common/pill.png</texture>
                    </control>
                    <control type="image">
                        <left>16</left>
                        <top>17</top>
                        <width>10</width>
                        <height>10</height>
                        <texture colordiffuse="FFCCCCCC">fenlight_common/circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(state),done)</visible>
                    </control>
                    <control type="image">
                        <left>16</left>
                        <top>17</top>
                        <width>10</width>
                        <height>10</height>
                        <texture colordiffuse="FF5C7591">fenlight_common/circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(state),scanning)</visible>
                        <animation effect="fade" start="30" end="100" time="600" pulse="true" condition="true">Conditional</animation>
                    </control>
                    <control type="image">
                        <left>16</left>
                        <top>17</top>
                        <width>10</width>
                        <height>10</height>
                        <texture colordiffuse="FFB40025">fenlight_common/circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(state),failed)</visible>
                    </control>
                    <control type="label">
                        <left>36</left>
                        <width>190</width>
                        <height>44</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Property(name)]$INFO[ListItem.Property(count),  [B],[/B]]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="246" height="56">
                    <control type="image">
                        <width>234</width>
                        <height>44</height>
                        <texture colordiffuse="D91F2020" border="22">fenlight_common/pill.png</texture>
                    </control>
                    <control type="image">
                        <left>16</left>
                        <top>17</top>
                        <width>10</width>
                        <height>10</height>
                        <texture colordiffuse="FFCCCCCC">fenlight_common/circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(state),done)</visible>
                    </control>
                    <control type="image">
                        <left>16</left>
                        <top>17</top>
                        <width>10</width>
                        <height>10</height>
                        <texture colordiffuse="FF5C7591">fenlight_common/circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(state),scanning)</visible>
                        <animation effect="fade" start="30" end="100" time="600" pulse="true" condition="true">Conditional</animation>
                    </control>
                    <control type="image">
                        <left>16</left>
                        <top>17</top>
                        <width>10</width>
                        <height>10</height>
                        <texture colordiffuse="FFB40025">fenlight_common/circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(state),failed)</visible>
                    </control>
                    <control type="label">
                        <left>36</left>
                        <width>190</width>
                        <height>44</height>
                        <font>font10</font> <!-- FENLIGHT_21 -->
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Property(name)]$INFO[ListItem.Property(count),  [B],[/B]]</label>
                    </control>
                </focusedlayout>
            </control>
            <control type="textbox" id="2002">
                <left>90</left>
                <top>928</top>
                <width>1650</width>
                <height>110</height>
                <font>font12</font> <!-- FENLIGHT_26 -->
                <align>left</align>
                <aligny>bottom</aligny>
                <textcolor>FFB7B4BB</textcolor>
                <visible>String.IsEqual(Window.Property(window_mode),resolver)</visible>
            </control>
            <control type="image">
                <visible>String.IsEqual(Window.Property(enable_busy_spinner),true)</visible>
                <left>1800</left>
                <top>1003</top>
                <width>30</width>
                <height>30</height>
                <texture flipx="true" colordiffuse="FFFAFAFA">fenlight_common/spinner.png</texture>
                <animation effect="fade" time="320" delay="400">Visible</animation>
                <animation effect="rotate" end="360" center="auto" time="1200" loop="true" reversible="false" condition="true">Conditional</animation>
                <animation effect="fade" start="70" time="1200" condition="true" pulse="true">Conditional</animation>
            </control>
            <control type="progress" id="5000">
                <description>Progressbar</description>
                <left>90</left>
                <top>1048</top>
                <width>1740</width>
                <height>6</height>
                <texturebg colordiffuse="33FFFFFF">fenlight_common/white.png</texturebg>
                <lefttexture />
                <midtexture colordiffuse="FFCCCCCC">fenlight_common/white.png</midtexture>
                <righttexture />
            </control>
            <control type="progress" id="5001">
                <description>Progressbar near timeout</description>
                <left>90</left>
                <top>1048</top>
                <width>1740</width>
                <height>6</height>
                <texturebg colordiffuse="00FFFFFF">fenlight_common/white.png</texturebg>
                <lefttexture />
                <midtexture colordiffuse="FFB40025">fenlight_common/white.png</midtexture>
                <righttexture />
                <visible>String.IsEqual(Window.Property(progress_late),true)</visible>
            </control>
            <!-- Resume -->
            <control type="grouplist">
                <visible>String.IsEqual(Window.Property(window_mode),resume)</visible>
                <left>90</left>
                <top>975</top>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <control type="button" id="10">
                    <description>Resume</description>
                    <width min="200">auto</width>
                    <height>60</height>
                    <textoffsetx>30</textoffsetx>
                    <onleft>12</onleft>
                    <onright>11</onright>
                    <label>$INFO[Window.Property(resume_label)]</label>
                    <font>font12</font> <!-- FENLIGHT_26 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="FFCCCCCC" border="30">fenlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347" border="30">fenlight_common/circle.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
                <control type="button" id="11">
                    <description>Start Over</description>
                    <width>200</width>
                    <height>60</height>
                    <onleft>10</onleft>
                    <onright>12</onright>
                    <label>Start Over</label>
                    <font>font12</font> <!-- FENLIGHT_26 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="FFCCCCCC" border="30">fenlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347" border="30">fenlight_common/circle.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
                <control type="button" id="12">
                    <description>Cancel</description>
                    <width>200</width>
                    <height>60</height>
                    <onleft>11</onleft>
                    <onright>10</onright>
                    <label>Cancel</label>
                    <font>font12</font> <!-- FENLIGHT_26 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="FFCCCCCC" border="30">fenlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347" border="30">fenlight_common/circle.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
            </control>
            <control type="label">
                <visible>String.IsEqual(Window.Property(window_mode),resume) + String.IsEqual(Window.Property(resume_no_seek),true)</visible>
                <left>90</left>
                <top>925</top>
                <width>1740</width>
                <height>40</height>
                <font>font12</font> <!-- FENLIGHT_26 -->
                <textcolor>FFB7B4BB</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>Resume unavailable when using 'no seek'</label>
            </control>
        </control>
    </controls>
</window>
